# --- Browser (public, safe to ship) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-SUPABASE-PUBLISHABLE-(ANON)-KEY

# --- Server only (set these in Vercel -> Settings -> Environment Variables, never commit them) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-SUPABASE-PUBLISHABLE-(ANON)-KEY
AI_API_KEY=YOUR-AI-KEY
# Optional (defaults shown):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# Needed on Vercel so the server code is built for Vercel:
NITRO_PRESET=vercel
